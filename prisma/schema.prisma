generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      String   @default("MEMBER") // OWNER | ADMIN | MEMBER | CLIENT
  color     String   @default("#6366f1")
  createdAt DateTime @default(now())
  memberships WorkspaceMember[]
  posts     Post[]
  approvals Approval[]
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  plan      String   @default("AGENCY") // SOLO | TEAM | AGENCY
  createdAt DateTime @default(now())
  members   WorkspaceMember[]
  brands    Brand[]
  media     MediaAsset[]
}

model WorkspaceMember {
  id          String @id @default(cuid())
  user        User   @relation(fields: [userId], references: [id])
  userId      String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  workspaceId String
  role        String @default("MEMBER")
  @@unique([userId, workspaceId])
}

model Brand {
  id          String @id @default(cuid())
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  workspaceId String
  name        String
  industry    String
  color       String @default("#0ea5e9")
  posts       Post[]
  metrics     AnalyticsMetric[]
}

model Post {
  id          String   @id @default(cuid())
  brand       Brand    @relation(fields: [brandId], references: [id])
  brandId     String
  author      User     @relation(fields: [authorId], references: [id])
  authorId    String
  content     String
  contentAr   String?
  status      String   @default("DRAFT") // DRAFT | PENDING_APPROVAL | APPROVED | REJECTED | SCHEDULED | PUBLISHED
  channels    String   // comma separated: X,LINKEDIN,FACEBOOK,INSTAGRAM
  media       MediaAsset? @relation(fields: [mediaId], references: [id])
  mediaId     String?
  scheduledAt DateTime?
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  approvals   Approval[]
}

model Approval {
  id         String   @id @default(cuid())
  post       Post     @relation(fields: [postId], references: [id])
  postId     String
  reviewer   User     @relation(fields: [reviewerId], references: [id])
  reviewerId String
  decision   String   // APPROVED | REJECTED
  note       String?
  createdAt  DateTime @default(now())
}

model MediaAsset {
  id          String   @id @default(cuid())
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  workspaceId String
  title       String
  kind        String   @default("image")
  path        String   // under /public/media
  tags        String   @default("")
  createdAt   DateTime @default(now())
  posts       Post[]
}

model AnalyticsMetric {
  id          String   @id @default(cuid())
  brand       Brand    @relation(fields: [brandId], references: [id])
  brandId     String
  channel     String
  date        DateTime
  impressions Int      @default(0)
  engagements Int      @default(0)
  clicks      Int      @default(0)
  followers   Int      @default(0)
}
